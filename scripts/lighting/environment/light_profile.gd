class_name LightProfile
extends Resource
## Настройки искусственного источника света.
##
## Профиль содержит только конфигурацию и не должен хранить изменяемое
## игровое состояние: ресурсы в Godot по умолчанию shared, и два светильника
## с одним файлом .tres влияли бы друг на друга. Всё рантайм-состояние
## (текущая энергия, таймеры, вкл/выкл) живёт в ArtificialLightSource.

# --- Основные ---

## Цвет света.
@export var color: Color = Color(1.0, 0.85, 0.6)
## Базовая энергия света.
@export_range(0.0, 8.0, 0.01) var energy: float = 1.5

# --- Форма ---

## Текстура светового пятна. Если не назначена, используется стандартная
## радиальная текстура источника.
@export var light_texture: Texture2D
## Масштаб текстуры светового пятна.
@export_range(0.05, 16.0, 0.05) var texture_scale: float = 1.0
## Смещение излучателя относительно позиции источника (локальные координаты).
@export var light_offset: Vector2 = Vector2.ZERO

# --- Тени ---

## Отбрасывает ли источник стандартные тени Godot (LightOccluder2D).
@export var shadows_enabled: bool = true
## Маска окклюдеров, отбрасывающих тени от этого источника.
## ВАЖНО (проверено на Godot 4.7): тень строится только если маска
## окклюдера (occluder_light_mask) совпадает ещё и с Range > Item Cull Mask
## источника (по умолчанию 1). Пара «2 у света / 2 у окклюдера» при
## Range = 1 теней НЕ даёт. Стандарт проекта: окклюдеры искусственного
## света живут на слое 1.
@export_flags_2d_physics var shadow_item_cull_mask: int = 1
## Цвет затемнения в тени.
@export var shadow_color: Color = Color(0.0, 0.0, 0.0, 1.0)

# --- Поведение ---

## Режим работы источника. Обработка каждый кадр включается только
## для включённых источников не в режиме CONSTANT.
enum Behavior {
	## Постоянный свет без анимации.
	CONSTANT,
	## Мерцание: скачкообразная смена яркости (лампа, свеча, неисправная лампочка).
	FLICKER,
	## Пульсация: плавная синусоида (аварийный свет, «дышащий» светильник).
	PULSE,
}

## Длительность плавного включения и выключения в секундах (0 = мгновенно).
@export_range(0.0, 5.0, 0.05) var fade_duration: float = 0.0
## Режим анимации света.
@export var behavior: Behavior = Behavior.CONSTANT
## Амплитуда анимации: яркость гуляет в диапазоне
## [1 - flicker_strength, 1 + flicker_strength] от базовой.
@export_range(0.0, 1.0, 0.01) var flicker_strength: float = 0.15
## Скорость анимации: для FLICKER — смен в секунду, для PULSE — полных
## циклов синусоиды в секунду.
@export_range(0.5, 30.0, 0.5) var flicker_speed: float = 8.0

# --- Группы ---

## Группы источника для массового управления
## (электричество, декоративное, аварийное и т.д.).
@export_flags("Электричество", "Декоративное", "Аварийное") var groups: int = 1

# --- Свечение плафона ---

## Цвет свечения самого светильника (плафон, пламя свечи).
## Alpha 0 — свечение отключено.
@export var emissive_color: Color = Color(1.0, 0.85, 0.6, 0.0)
## Текстура свечения (обычно радиальный градиент).
@export var emissive_texture: Texture2D
## Базовый масштаб узла свечения.
@export_range(0.05, 8.0, 0.05) var emissive_scale: float = 1.0
